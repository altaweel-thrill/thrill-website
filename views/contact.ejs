<!DOCTYPE html>
<% const isArabic = locale === "ar"; %>
<html lang="<%= isArabic ? 'ar' : 'en' %>" dir="<%= isArabic ? 'rtl' : 'ltr' %>">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= isArabic ? 'تواصل مع وكالة ثريل لبدء مشروعك الإبداعي والتسويقي' : 'Contact Thrill Agency to start your next creative project' %>">

  <title><%= isArabic ? 'تواصل معنا - وكالة ثريل' : 'Contact - Thrill Agency' %></title>
  <% if (isArabic) { %><base href="/"><% } %>
  <link rel="alternate" hreflang="en" href="/contact">
  <link rel="alternate" hreflang="ar" href="/ar/contact">

  <!-- Fav Icon -->
  <link rel="icon" type="image/x-icon" href="assets/imgs/logo/favicon.png">

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet">
  <% if (isArabic) { %>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <% } %>

  <!-- All CSS files -->
  <link rel="stylesheet" href="assets/css/bootstrap.min.css">
  <link rel="stylesheet" href="assets/css/all.min.css">
  <link rel="stylesheet" href="assets/css/swiper-bundle.min.css">
  <link rel="stylesheet" href="assets/css/progressbar.css">
  <link rel="stylesheet" href="assets/css/meanmenu.min.css">
  <link rel="stylesheet" href="assets/css/master.css">
  <link rel="stylesheet" href="/assets/css/style.css">

<script src="https://www.google.com/recaptcha/api.js?render=6LdZxNYsAAAAAFet6g0axs3w1JAcgaDY-vahAlLh"></script>

<!-- Google Tag Manager -->
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-M9D497GS');</script>
  <!-- End Google Tag Manager -->
  </head>


<body class="dark<%= isArabic ? ' dir-rtl arabic-page contact-arabic' : '' %>">

  <!-- Cursor Animation -->
  <div class="cursor1"></div>
  <div class="cursor2"></div>


  <!-- Preloader -->
  <%- include('components/loading.ejs'); -%>



 



  <!-- Scroll Smoother -->
  <div class="has-smooth" id="has_smooth"></div>


  <!-- Go Top Button -->
  <button id="scroll_top" class="scroll-top"><i class="fa-solid fa-arrow-up"></i></button>


  <!-- Header area start -->
  <%- include('components/header.ejs', {
    isArabic,
    languageSwitchHref: isArabic ? '/contact' : '/ar/contact'
  }); -%>

  <!-- Header area end -->


  <!-- Offcanvas area start -->
  
  <!-- Offcanvas area end -->


  <div id="smooth-wrapper">
    <div id="smooth-content">
      <main>

        <!-- Contact area start -->
        <section class="contact__area-6">
          <div class="container g-0 line pt-120 pb-110">
            <span class="line-3"></span>
            <div class="row">
              <div class="col-xxl-6 col-xl-6 col-lg-6 col-md-6">
                <div class="sec-title-wrapper">
                  <h2 class="sec-title-2<%= isArabic ? '' : ' animation__char_come' %>"><%= isArabic ? 'لنتواصل معاً' : 'Let’s get in touch' %></h2>
                </div>
              </div>
              <div class="col-xxl-6 col-xl-6 col-lg-6 col-md-6">
                <div class="contact__text">
                  <p><%= isArabic
                    ? 'يسعدنا أن نسمع منك ونبدأ معاً شيئاً مميزاً. تواصل معنا لأي استفسار أو مشروع جديد.'
                    : "Great! We're excited to hear from you and start something special together. Call us for any inquiry." %></p>
                </div>
              </div>
            </div>
            <div class="row contact__btm">
              <div class="col-xxl-5 col-xl-5 col-lg-5 col-md-5">
                <div class="contact__info">
                  <h3 class="<%= isArabic ? '' : 'sub-title-anim-top animation__word_come' %>">
                    <span><%= isArabic ? 'جاهز لبدء مشروعك؟' : 'Get Thrilled!' %></span>
                    <span><%= isArabic ? 'لنصنع شيئاً رائعاً معاً' : "Say let's Thrill it" %></span>
                  </h3>
                  <ul>
                    <li><a href="tel:+966536900404">+966 536 900 404</a></li>
                    <li><a href="mailto:hello@thrillagency.net">hello@thrillagency.net</a></li>
                    <li class="contact__whatsapp">
                      <div class="contact__whatsapp-wrap">
                        <a id="Wsthrill" href="https://wa.me/966536900404" target="_blank" rel="noopener" class="contact__whatsapp-btn">
                            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-whatsapp" viewBox="0 0 16 16">
                            <path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.71 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232"/>
                          </svg>
                          <span><%= isArabic ? 'أرسل رسالة' : 'Send Message' %></span>
                        </a>
                      </div>
                    </li>
                    <li>
                      <h3><%= isArabic ? 'المملكة العربية السعودية' : 'Saudi Arabia' %></h3>
                      <p><%= isArabic
                        ? 'برج سدرة، طريق الأمير سلطان بن عبدالعزيز، حي الأندلس، الخبر'
                        : 'Sidra Tower, Prince Sultan Bin Abdulaziz Rd, Al Andalus District, Al-Khobar' %></p>
                    </li>
                    <li class="contact__branch"><a href="tel:+971505546565">+971 50 554 6565</a></li>
                    <li><a href="mailto:hello@thrillagency.net">hello@thrillagency.net</a></li>
                    <li>
                      <h3><%= isArabic ? 'الإمارات العربية المتحدة' : 'United Arab Emirates' %></h3>
                      <p><%= isArabic ? 'الخليج التجاري، دبي' : 'Business Bay - Dubai' %></p>
                    </li>
                  </ul>
                </div>
              </div>
              <div class="col-xxl-7 col-xl-7 col-lg-7 col-md-7">
                <div class="contact__form">
                  <form action="/contact" method="post" id="contactForm">
                    <input type="hidden" name="recaptchaToken" id="recaptchaToken">
                    <input type="hidden" name="locale" value="<%= isArabic ? 'ar' : 'en' %>">
                    <input type="hidden" name="contactFormToken" value="<%= contactFormToken %>">

                    <!-- Honeypot ضد البوتات -->
                    <div aria-hidden="true" style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden;">
                      <label for="contactWebsite">Website</label>
                      <input type="text" id="contactWebsite" name="website" tabindex="-1" autocomplete="off">
                    </div>

                    <div class="row g-3">
                      <div class="col-xxl-6 col-xl-6 col-12">
                        <input type="text" required minlength="2" maxlength="100" name="name" autocomplete="name" placeholder="<%= isArabic ? 'الاسم *' : 'Name *' %>">
                      </div>
                      <div class="col-xxl-6 col-xl-6 col-12">
                        <input type="email" required maxlength="254" name="email" autocomplete="email" placeholder="<%= isArabic ? 'البريد الإلكتروني *' : 'Email *' %>">
                      </div>
                    </div>
                    <div class="row g-3">
                      <div class="col-xxl-6 col-xl-6 col-12">
                        <input type="tel" required minlength="7" maxlength="30" name="phone" autocomplete="tel" dir="ltr" placeholder="<%= isArabic ? 'رقم الهاتف *' : 'Phone *' %>">
                      </div>
                      <div class="col-xxl-6 col-xl-6 col-12">
                        <input type="text" required minlength="2" maxlength="150" name="subject" placeholder="<%= isArabic ? 'الموضوع *' : 'Subject *' %>">
                      </div>
                    </div>
                    <div class="row g-3">
                      <div class="col-12">
                        <textarea name="message" required minlength="10" maxlength="5000" placeholder="<%= isArabic ? 'اكتب رسالتك *' : 'Message *' %>"></textarea>
                      </div>
                    </div>
                    <div class="row g-3">
                      <div class="col-12">
                        <div class="btn_wrapper">
                          <button type="submit" class="wc-btn-primary btn-hover btn-item"><span></span><%= isArabic ? 'إرسال الرسالة' : 'Send Message' %> <i
                              class="fa-solid fa-arrow-<%= isArabic ? 'left' : 'right' %>"></i></button>
                        </div>
                      </div>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          </div>
        </section>
        <!-- Contact area end -->

      </main>


      <!-- Footer area start -->
      <%- include('components/footer.ejs', { isArabic }); -%>

      <!-- Footer area end -->


    </div>
  </div>



  <!-- All JS files -->
  <script src="assets/js/jquery-3.6.0.min.js"></script>
  <script src="assets/js/bootstrap.bundle.min.js"></script>
  <script src="assets/js/swiper-bundle.min.js"></script>
  <script src="assets/js/counter.js"></script>
  <script src="assets/js/gsap.min.js"></script>
  <script src="assets/js/ScrollTrigger.min.js"></script>
  <script src="assets/js/ScrollToPlugin.min.js"></script>
  <script src="assets/js/ScrollSmoother.min.js"></script>
  <script src="assets/js/SplitText.min.js"></script>
  <script src="assets/js/chroma.min.js"></script>
  <script src="assets/js/mixitup.min.js"></script>
  <script src="assets/js/vanilla-tilt.js"></script>
  <script src="assets/js/jquery.meanmenu.min.js"></script>
  <script src="assets/js/main.js"></script>


  
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-M9D497GS"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
<script>
  const contactForm = document.getElementById("contactForm");

  contactForm.addEventListener("submit", function (e) {
    e.preventDefault();

    grecaptcha.ready(function () {
      grecaptcha.execute(
        "6LdZxNYsAAAAAFet6g0axs3w1JAcgaDY-vahAlLh",
        { action: "CONTACT_FORM" }
      ).then(function (token) {
        document.getElementById("recaptchaToken").value = token;
        HTMLFormElement.prototype.submit.call(contactForm);
      });
    });
  });
</script>
</body>

</html>
