<style>
body {
  margin: 0;
  background: #0a0a0a;
  font-family: "Kanit", sans-serif;
  color: #fff;
}

.page-header {
  padding: 140px 0 80px;
  text-align: center;
}

.page-header h1 {
  font-size: clamp(2.5rem, 4vw, 4rem);
  font-weight: 600;
  margin: 0;
}

.page-header p {
  margin-top: 14px;
  font-size: 16px;
  color: #9f9f9f;
}

.reels-portfolio {
  padding-bottom: 120px;
}

.container {
  max-width: 1400px;
  margin: auto;
  padding: 0 24px;
}

.reels-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 28px;
}

.reel-card {
  position: relative;
  border-radius: 22px;
  overflow: hidden;
  background: #000;
  cursor: pointer;
}

.reel-card .media {
  aspect-ratio: 3 / 4;
  overflow: hidden;
}
.reel-card .media2 {
  aspect-ratio: 9 / 16;
  overflow: hidden;
}


.reel-card img,
.reel-card video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .5s ease, filter .4s ease;
}

.reel-card .overlay {
  position: absolute;
  inset: 0;
  padding: 22px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  gap: 8px;
  opacity: 0;
  visibility: hidden;
  transition: opacity .35s ease;
}

.reel-card:hover .overlay {
  opacity: 1;
  visibility: visible;
}

.reel-card:hover img,
.reel-card:hover video {
  filter: brightness(0.55);
  transform: scale(1.05);
}

.overlay h4 {
  margin: 4px 0 0;
  font-size: 16px;
  font-weight: 500;
}

.overlay p {
  margin: 0;
  font-size: 13px;
  color: #d0d0d0;
}

.tag {
  font-size: 11px;
  padding: 4px 12px;
  border-radius: 100px;
  background: #ff0050;
  width: fit-content;
}

.play-icon {
  position: absolute;
  inset: 0;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44px;
  color: #fff;
  opacity: 1;
  transition: opacity .3s ease;
  pointer-events: none;
}

.reel-card.video:hover .play-icon {
  opacity: 0;
}

.reel-card .swiper,
.reel-card .swiper-slide {
  width: 100%;
  height: 100%;
}

.reel-card .swiper-slide img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.multi-icon {
  position: absolute;
  top: 14px;
  right: 14px;
  z-index: 4;
  background: rgba(0,0,0,.6);
  width: 32px;
  height: 32px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cta {
  border-top: 1px solid rgba(255,255,255,.08);
  padding: 100px 24px;
  text-align: center;
}

.cta span {
  display: block;
  font-size: 13px;
  letter-spacing: .12em;
  color: #888;
  margin-bottom: 14px;
}

.cta h2 {
  font-size: clamp(2rem, 3vw, 2.8rem);
  font-weight: 600;
  margin: 0;
}

.cta a {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin-top: 32px;
  padding: 14px 28px;
  border-radius: 100px;
  background: #fff;
  color: #000;
  font-size: 15px;
  text-decoration: none;
  transition: transform .3s ease;
}

.cta a:hover {
  transform: translateY(-3px);
}

.media-popup {
  position: fixed;
  inset: 0;
  z-index: 99999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28px;
  background: rgba(0, 0, 0, .88);
  opacity: 0;
  visibility: hidden;
  transition: opacity .25s ease, visibility .25s ease;
}

.media-popup.is-open {
  opacity: 1;
  visibility: visible;
}

.media-popup__content {
  position: relative;
  width: min(92vw, 720px);
  max-height: 90vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.media-popup__stage {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.media-popup__stage img,
.media-popup__stage video {
  max-width: 100%;
  max-height: 90vh;
  border-radius: 18px;
  object-fit: contain;
  background: #000;
}

.media-popup__stage video {
  width: min(92vw, 520px);
}

.media-popup__close,
.media-popup__nav {
  position: absolute;
  z-index: 2;
  border: 0;
  color: #fff;
  background: rgba(0, 0, 0, .62);
  cursor: pointer;
  transition: background .2s ease, transform .2s ease;
}

.media-popup__close:hover,
.media-popup__nav:hover {
  background: rgba(255, 255, 255, .16);
}

.media-popup__close {
  top: -18px;
  right: -18px;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  font-size: 20px;
}

.media-popup__nav {
  top: 50%;
  width: 44px;
  height: 58px;
  border-radius: 14px;
  font-size: 22px;
  transform: translateY(-50%);
}

.media-popup__nav:hover {
  transform: translateY(-50%) scale(1.04);
}

.media-popup__prev {
  left: -58px;
}

.media-popup__next {
  right: -58px;
}

.media-popup__counter {
  position: absolute;
  left: 50%;
  bottom: -34px;
  transform: translateX(-50%);
  min-width: 54px;
  padding: 5px 12px;
  border-radius: 99px;
  background: rgba(0, 0, 0, .62);
  color: #fff;
  font-size: 13px;
  text-align: center;
}

.media-popup__nav[hidden],
.media-popup__counter[hidden] {
  display: none;
}

body.media-popup-open {
  overflow: hidden;
}

@media (max-width: 1200px) {
  .reels-grid { grid-template-columns: repeat(3,1fr); }
}
@media (max-width: 991px) {
  .reels-grid { grid-template-columns: repeat(2,1fr); }
}
@media (max-width: 575px) {
  .reels-grid { grid-template-columns: 1fr; }
  .media-popup {
    padding: 18px;
  }
  .media-popup__content {
    max-height: 86vh;
  }
  .media-popup__stage img,
  .media-popup__stage video {
    max-height: 86vh;
  }
  .media-popup__close {
    top: 10px;
    right: 10px;
  }
  .media-popup__prev {
    left: 10px;
  }
  .media-popup__next {
    right: 10px;
  }
  .media-popup__nav {
    background: rgba(0, 0, 0, .72);
  }
  .media-popup__counter {
    bottom: 12px;
  }
}
</style>
</head>

