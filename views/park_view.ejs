<script>
document.querySelectorAll(".reel-card.video video").forEach(video => {
  const card = video.closest(".reel-card");

  card.addEventListener("mouseenter", () => {
    video.play().catch(()=>{});
  });

  card.addEventListener("mouseleave", () => {
    video.pause();
    video.currentTime = 0;
  });
});
</script>

<script>
(() => {
  const popup = document.getElementById("mediaPopup");
  if (!popup) return;

  document.body.appendChild(popup);

  const stage = popup.querySelector(".media-popup__stage");
  const closeButton = popup.querySelector(".media-popup__close");
  const prevButton = popup.querySelector(".media-popup__prev");
  const nextButton = popup.querySelector(".media-popup__next");
  const counter = popup.querySelector(".media-popup__counter");
  let items = [];
  let currentIndex = 0;

  const normalizeSrc = (src) => {
    if (!src) return "";
    return src.replace(/\\/g, "/");
  };

  const pauseGridVideos = () => {
    document.querySelectorAll(".reel-card.video video").forEach((video) => {
      video.pause();
      video.currentTime = 0;
    });
  };

  const collectItems = (card) => {
    const video = card.querySelector("video");
    if (video) {
      return [{
        type: "video",
        src: normalizeSrc(video.currentSrc || video.getAttribute("src"))
      }];
    }

    const seen = new Set();
    return Array.from(card.querySelectorAll(".swiper-slide:not(.swiper-slide-duplicate) img, img"))
      .map((img) => ({
        type: "image",
        src: normalizeSrc(img.currentSrc || img.getAttribute("src")),
        alt: img.getAttribute("alt") || "Park View preview"
      }))
      .filter((item) => {
        if (!item.src || seen.has(item.src)) return false;
        seen.add(item.src);
        return true;
      });
  };

  const updateControls = () => {
    const hasMultiple = items.length > 1;
    prevButton.hidden = !hasMultiple;
    nextButton.hidden = !hasMultiple;
    counter.hidden = !hasMultiple;
    counter.textContent = hasMultiple ? `${currentIndex + 1} / ${items.length}` : "";
  };

  const renderItem = () => {
    stage.innerHTML = "";
    const item = items[currentIndex];
    if (!item) return;

    if (item.type === "video") {
      const video = document.createElement("video");
      video.src = item.src;
      video.controls = true;
      video.autoplay = true;
      video.muted = true;
      video.playsInline = true;
      video.preload = "auto";
      video.addEventListener("loadeddata", () => {
        video.play().catch(() => {});
      });
      stage.appendChild(video);
    } else {
      const image = document.createElement("img");
      image.src = item.src;
      image.alt = item.alt;
      stage.appendChild(image);
    }

    updateControls();
  };

  const openPopup = (nextItems) => {
    items = nextItems;
    currentIndex = 0;
    pauseGridVideos();
    renderItem();
    popup.classList.add("is-open");
    popup.setAttribute("aria-hidden", "false");
    document.body.classList.add("media-popup-open");
  };

  const closePopup = () => {
    popup.classList.remove("is-open");
    popup.setAttribute("aria-hidden", "true");
    document.body.classList.remove("media-popup-open");
    stage.querySelectorAll("video").forEach((video) => video.pause());
    stage.innerHTML = "";
  };

  const showOffset = (offset) => {
    if (!items.length) return;
    currentIndex = (currentIndex + offset + items.length) % items.length;
    renderItem();
  };

  document.querySelectorAll(".reel-card").forEach((card) => {
    card.addEventListener("click", () => {
      const nextItems = collectItems(card);
      if (nextItems.length) openPopup(nextItems);
    });
  });

  closeButton.addEventListener("click", closePopup);
  prevButton.addEventListener("click", () => showOffset(-1));
  nextButton.addEventListener("click", () => showOffset(1));
  popup.addEventListener("click", (event) => {
    if (event.target === popup) closePopup();
  });
  document.addEventListener("keydown", (event) => {
    if (!popup.classList.contains("is-open")) return;
    if (event.key === "Escape") closePopup();
    if (event.key === "ArrowLeft") showOffset(-1);
    if (event.key === "ArrowRight") showOffset(1);
  });
})();
</script>

