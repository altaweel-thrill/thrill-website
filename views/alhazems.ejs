  const card = video.closest(".reel-card");

  card.addEventListener("mouseenter", () => {
    video.play().catch(()=>{});
  });

  card.addEventListener("mouseleave", () => {
    video.pause();
    video.currentTime = 0;
  });
});
</script>

</body>
</html>