<% const headerIsArabic = typeof isArabic !== "undefined" && isArabic; %>
<% const headerLanguageSwitchHref = typeof languageSwitchHref !== "undefined" ? languageSwitchHref : (headerIsArabic ? "/" : "/ar"); %>
<!-- Header area start -->
<header class="header__area-2">
    <div class="header__inner-2">
      <div class="header__logo-2">
