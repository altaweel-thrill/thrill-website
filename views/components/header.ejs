        <li class=""><a href="<%= headerIsArabic ? '/ar/about' : '/about' %>"><%= headerIsArabic ? 'من نحن' : 'About us' %></a>
        <li class=""><a href="<%= headerIsArabic ? '/ar/service' : '/service' %>"><%= headerIsArabic ? 'خدماتنا' : 'Services' %></a>
        <!-- <li class=""><a href="/portfolio">Portfolio</a> -->

             <li><a href="#"><%= headerIsArabic ? 'أعمالنا' : 'Portfolio' %></a>
            <ul class="main-dropdown">
              <li><a href="<%= headerIsArabic ? '/ar/portfolio' : '/portfolio' %>"><%= headerIsArabic ? 'الهوية والعلامة' : 'Branding' %></a></li>
                <li><a href="<%= headerIsArabic ? '/ar/social-media' : '/social-media' %>"><%= headerIsArabic ? 'التواصل الاجتماعي' : 'Social Media' %></a></li>
              <li><a href="<%= headerIsArabic ? '/ar/web-and-app' : '/web-and-app' %>"><%= headerIsArabic ? 'المواقع والتطبيقات' : 'Websites and Apps' %></a></li>
             
            </ul>
          </li>
        <li class=""><a href="<%= headerIsArabic ? '/ar/contact' : '/contact' %>"><%= headerIsArabic ? 'تواصل معنا' : 'Contact' %></a>
        <li class=""><a href="tel:+920000404">920000404</a> </li>
        <li class="language-switch"><a href="<%= headerLanguageSwitchHref %>" lang="<%= headerIsArabic ? 'en' : 'ar' %>"><%= headerIsArabic ? 'English' : 'العربية' %></a></li>

       
