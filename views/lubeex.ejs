<style>
body {
  margin: 0;
  background: #0a0a0a;
  font-family: "Kanit", sans-serif;
  color: #fff;
}

/* ================= TITLE ================= */
.page-header {
  padding: 140px 0 80px;
  text-align: center;
}

.page-header h1 {
  font-size: clamp(2.5rem, 4vw, 4rem);
  font-weight: 600;
  margin: 0;
}

.page-header p {
  margin-top: 14px;
  font-size: 16px;
  color: #9f9f9f;
}

/* ================= SECTION ================= */
.reels-portfolio {
  padding-bottom: 120px;
}

.container {
  max-width: 1400px;
  margin: auto;
  padding: 0 24px;
}

/* ================= GRID ================= */
.reels-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 28px;
}

/* ================= CARD ================= */
.reel-card {
  position: relative;
  border-radius: 22px;
  overflow: hidden;
  background: #000;
  cursor: pointer;
}

/* 9:16 */
.reel-card .media {
  aspect-ratio: 4 / 4 ;
  overflow: hidden;
}

/* 9:16 */
.reel-card .media2 {
  aspect-ratio: 9 / 16 ;
  overflow: hidden;
}

.reel-card img,
.reel-card video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .5s ease, filter .4s ease;
}

/* Overlay */
.reel-card .overlay {
  position: absolute;
  inset: 0;
  padding: 22px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  gap: 8px;
  opacity: 0;
  visibility: hidden;
  transition: opacity .35s ease;
}

.reel-card.video:hover .play-icon {
  opacity: 0;
}

.play-icon {
  position: absolute;
  inset: 0;
  z-index: 3;                 /* 👈 أعلى من الفيديو */
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44px;
  color: #fff;
  opacity: 1;                 /* 👈 ظاهرة */
  transition: opacity .25s ease;
  pointer-events: none;
}

/* ✅ CSS HOVER ONLY (NO JS) */
.reel-card:hover .overlay {
  opacity: 1;
  visibility: visible;
}

.reel-card:hover img,
.reel-card:hover video {
  filter: brightness(0.55);
  transform: scale(1.05);

}

/* Text */
.overlay h4 {
  margin: 0;
  font-size: 16px;
}

.overlay p {
  margin: 0;
  font-size: 13px;
  color: #ccc;
}

/* Tag */
.tag {
  font-size: 11px;
  padding: 4px 12px;
  border-radius: 100px;
  background: #ff0050;
  width: fit-content;
}

/* Play Icon */
.play-icon {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42px;
  color: #fff;
  opacity: 0;
  transition: opacity .3s ease;
  pointer-events: none;
}

/* PLAY ICON – visible by default */
.play-icon {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42px;
  color: #fff;
  opacity: 1;              /* 👈 ظاهرة */
  transition: opacity .3s ease;
  pointer-events: none;
}

/* ❌ تختفي عند hover */
.reel-card.video:hover .play-icon {
  opacity: 0;
}

.overlay h4 {
  margin: 4px 0 0;
  font-size: 16px;
  font-weight: 500;
}

.overlay p {
  margin: 0;
  font-size: 13px;
  color: #d0d0d0;
}

/* TAG */
.tag {
  width: fit-content;
  font-size: 11px;
  padding: 4px 12px;
  border-radius: 100px;
  background: #ff0050;
}

/* PLAY ICON */
.play-icon {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44px;
  color: #fff;
  opacity: 1;
  transition: opacity .3s ease;
  pointer-events: none;
}



/* ================= CTA ================= */
.cta {
  border-top: 1px solid rgba(255,255,255,.08);
  padding: 100px 24px;
  text-align: center;
}

.cta span {
  display: block;
  font-size: 13px;
  letter-spacing: 0.12em;
  color: #888;
  margin-bottom: 14px;
}

.cta h2 {
  font-size: clamp(2rem, 3vw, 2.8rem);
  font-weight: 600;
  margin: 0;
}

.cta a {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin-top: 32px;
  padding: 14px 28px;
  border-radius: 100px;
  background: #fff;
  color: #000;
  font-size: 15px;
  text-decoration: none;
  transition: transform .3s ease;
}

.cta a:hover {
  transform: translateY(-3px);
}

/* ================= RESPONSIVE ================= */
@media (max-width: 1200px) {
  .reels-grid { grid-template-columns: repeat(3, 1fr); }
}

@media (max-width: 991px) {
  .reels-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 575px) {
  .reels-grid { grid-template-columns: 1fr; }
}
</style>
