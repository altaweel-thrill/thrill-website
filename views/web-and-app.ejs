<!DOCTYPE html>
<% const isArabic = locale === "ar"; %>
<html lang="<%= isArabic ? 'ar' : 'en' %>" dir="<%= isArabic ? 'rtl' : 'ltr' %>">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= isArabic ? 'مختارات من مشاريع تصميم وتطوير المواقع والتطبيقات لدى وكالة ثريل' : 'Selected website and application projects by Thrill Agency' %>">

  <title><%= isArabic ? 'المواقع والتطبيقات - وكالة ثريل' : 'Websites and Apps - Thrill Agency' %></title>
  <% if (isArabic) { %><base href="/"><% } %>
  <link rel="alternate" hreflang="en" href="/web-and-app">
  <link rel="alternate" hreflang="ar" href="/ar/web-and-app">

  <!-- Fav Icon -->
  <link rel="icon" type="image/x-icon" href="assets/imgs/logo/favicon.png">

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet">
  <% if (isArabic) { %>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <% } %>

  <!-- All CSS files -->
  <link rel="stylesheet" href="assets/css/bootstrap.min.css">
  <link rel="stylesheet" href="assets/css/all.min.css">
  <link rel="stylesheet" href="assets/css/swiper-bundle.min.css">
  <link rel="stylesheet" href="assets/css/progressbar.css">
  <link rel="stylesheet" href="assets/css/meanmenu.min.css">
  <link rel="stylesheet" href="assets/css/master.css">
  <link rel="stylesheet" href="/assets/css/style.css">

<!-- Google Tag Manager -->
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-M9D497GS');</script>
  <!-- End Google Tag Manager -->
</head>


<body class="dark<%= isArabic ? ' dir-rtl arabic-page web-app-arabic' : '' %>">

  <!-- Cursor Animation -->
  <div class="cursor1"></div>
  <div class="cursor2"></div>


  <%- include('components/loading.ejs'); -%>



 



  <!-- Scroll Smoother -->
  <div class="has-smooth" id="has_smooth"></div>


  <!-- Go Top Button -->
  <button id="scroll_top" class="scroll-top"><i class="fa-solid fa-arrow-up"></i></button>


  <!-- Header area start -->
  <%- include('components/header', {
    isArabic,
    languageSwitchHref: isArabic ? '/web-and-app' : '/ar/web-and-app'
  }); -%>

  <!-- Header area end -->



  


  <div id="smooth-wrapper">
    <div id="smooth-content">
      <main>

        <!-- Hero area start -->
       


      


      <section class="pt-150 pb-130 portfolio-v2">
          <div class="container">
            <div class="row">
              <div class="col-xxl-8 col-xl-7 col-lg-6 col-md-6">
                <div class="sec-title-wrapper">
                  <h2 class="sec-title-2<%= isArabic ? '' : ' animation__char_come' %>"><%= isArabic ? 'مختارات من' : 'Selected' %> <br><%= isArabic ? 'مشاريعنا' : 'Projects' %></h2>
                </div>
              </div>
              <div class="col-xxl-4 col-xl-5 col-lg-6 col-md-6">
                <div class="blog__text">
                  <p><%= isArabic
                    ? 'نصمم ونطوّر مواقع وتطبيقات سريعة وسهلة الاستخدام، تجمع بين تجربة المستخدم الواضحة والحضور البصري المميز.'
                    : 'Designing and developing fast, user-friendly websites and applications with clear experiences and distinctive visual identities.' %></p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="portfolio__area pb-140">
          <div class="container">
            <div class="row top_row">

              <h2 class="portfolio__text"><%= isArabic ? 'المواقع والتطبيقات' : 'Websites' %><% if (!isArabic) { %><br>Apps<% } %></h2>
              <div class="portfolio__list-1">




                 <div class="portfolio__item">
                  <a target="_blank" rel="noopener" href="https://silica.sa"><img class="mover" src="assets/imgs/portfolio/websites/silica.png" alt="<%= isArabic ? 'مشروع موقع سيليكا' : 'Silica website project' %>"></a>
                  <div class="portfolio__info">
                    <h3 class="portfolio__title">Silica</h3>
                    <p><%= isArabic ? 'موقع إلكتروني' : 'Website' %></p>
                  </div>
                </div>



                 <div class="portfolio__item">
                  <a target="_blank" rel="noopener" href="https://flowy.one"><img class="mover" src="assets/imgs/portfolio/websites/flowy.png" alt="<%= isArabic ? 'مشروع موقع فلوي' : 'Flowy website project' %>"></a>
                  <div class="portfolio__info">
                    <h3 class="portfolio__title">Flowy</h3>
                    <p><%= isArabic ? 'موقع إلكتروني' : 'Website' %></p>
                  </div>
                </div>


                 <div class="portfolio__item">
                  <a target="_blank" rel="noopener" href="https://etereadymix.com.sa/"><img class="mover" src="assets/imgs/portfolio/websites/ete.png" alt="<%= isArabic ? 'مشروع موقع إي تي إي' : 'ETE website project' %>"></a>
                  <div class="portfolio__info">
                    <h3 class="portfolio__title">ETEREADYMIX</h3>
                    <p><%= isArabic ? 'موقع إلكتروني' : 'Website' %></p>
                  </div>
                </div>



                   <div class="portfolio__item">
                  <a target="_blank" rel="noopener" href="https://etarex.com"><img class="mover" src="assets/imgs/portfolio/websites/etarex.png" alt="<%= isArabic ? 'مشروع موقع إيتاركس' : 'Etarex website project' %>"></a>
                  <div class="portfolio__info">
                    <h3 class="portfolio__title">Etarex</h3>
                    <p><%= isArabic ? 'موقع إلكتروني' : 'Website' %></p>
                  </div>
                </div>


                   <div class="portfolio__item">
                  <a target="_blank" rel="noopener" href="https://aqed.sa"><img class="mover" src="assets/imgs/portfolio/websites/aqed.png" alt="<%= isArabic ? 'مشروع موقع عقد' : 'Aqed website project' %>"></a>
                  <div class="portfolio__info">
                    <h3 class="portfolio__title">Aqed</h3>
                    <p><%= isArabic ? 'موقع إلكتروني' : 'Website' %></p>
                  </div>
                </div>

               
               


               


                

               
               


              </div>
            </div>

           
          </div>
        </section>





        <!-- CTA area start -->
        <section class="cta__area">
          <div class="container line pb-110 dark-p">
            <div class="line-3"></div>
            <div class="row">
              <div class="col-xxl-12">
                <div class="cta__content">
                  <p class="cta__sub-title"><%= isArabic ? 'اعمل معنا' : 'Work with us' %></p>
                  <h2 class="cta__title<%= isArabic ? '' : ' title-anim' %>"><%= isArabic ? 'يسعدنا أن نعرف أكثر عن مشروعك' : 'We would love to hear more about your project' %></h2>
                  <div class="btn_wrapper">
                    <a href="<%= isArabic ? '/ar/contact' : '/contact' %>" class="wc-btn-primary btn-hover btn-item"><span></span><%= isArabic ? 'لنتحدث' : 'Let’s talk us' %> <i
                        class="fa-solid fa-arrow-<%= isArabic ? 'left' : 'right' %>"></i></a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
        <!-- CTA area end -->

      </main>



      <%- include('components/footer.ejs', { isArabic }); -%>


    </div>
  </div>


  <!-- All JS files -->
  <script src="assets/js/jquery-3.6.0.min.js"></script>
  <script src="assets/js/bootstrap.bundle.min.js"></script>
  <script src="assets/js/swiper-bundle.min.js"></script>
  <script src="assets/js/counter.js"></script>
  <script src="assets/js/gsap.min.js"></script>
  <script src="assets/js/ScrollTrigger.min.js"></script>
  <script src="assets/js/ScrollToPlugin.min.js"></script>
  <script src="assets/js/ScrollSmoother.min.js"></script>
  <script src="assets/js/SplitText.min.js"></script>
  <script src="assets/js/chroma.min.js"></script>
  <script src="assets/js/mixitup.min.js"></script>
  <script src="assets/js/vanilla-tilt.js"></script>
  <script src="assets/js/jquery.meanmenu.min.js"></script>
  <script src="assets/js/main.js"></script>

<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-M9D497GS"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->


</body>

</html>
