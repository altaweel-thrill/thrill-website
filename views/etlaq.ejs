<script>
document.querySelectorAll(".reel-card.video video").forEach(video => {
  const card = video.closest(".reel-card");

  card.addEventListener("mouseenter", () => {
    if (!document.body.classList.contains("media-popup-open")) video.play().catch(()=>{});
  });

  card.addEventListener("mouseleave", () => {
    video.pause();
    video.currentTime = 0;
  });
});
</script>

<script>
(() => {
  const popup = document.getElementById("mediaPopup");
  const previewAlt = popup.dataset.previewAlt || "ETLAQ preview";
  document.body.appendChild(popup);
  const stage = popup.querySelector(".media-popup__stage");
  const closeButton = popup.querySelector(".media-popup__close");
  const prevButton = popup.querySelector(".media-popup__prev");
  const nextButton = popup.querySelector(".media-popup__next");
  const counter = popup.querySelector(".media-popup__counter");
  let activeItems = [];
  let activeIndex = 0;

  const normalizeSrc = (src) => (src || "").replace(/\\/g, "/");

  const pauseGridVideos = () => {
    document.querySelectorAll(".reel-card.video video").forEach((video) => {
      video.pause();
      video.currentTime = 0;
    });
  };

  const getCardItems = (card) => {
    const video = card.querySelector("video");
    if (video) {
      return [{
        type: "video",
        src: normalizeSrc(video.currentSrc || video.getAttribute("src"))
      }];
    }

    let images = Array.from(
      card.querySelectorAll(".swiper-slide:not(.swiper-slide-duplicate) img")
    );

    if (!images.length) {
      images = Array.from(card.querySelectorAll("img"));
    }

    const seen = new Set();
    return images
      .map((img) => ({
        type: "image",
        src: normalizeSrc(img.currentSrc || img.getAttribute("src")),
        alt: img.getAttribute("alt") || previewAlt
      }))
      .filter((item) => {
        if (!item.src || seen.has(item.src)) return false;
        seen.add(item.src);
        return true;
      });
  };

  const renderActiveItem = () => {
    const item = activeItems[activeIndex];
    if (!item) return;

    stage.innerHTML = "";

    if (item.type === "video") {
      const video = document.createElement("video");
      video.src = item.src;
      video.controls = true;
      video.autoplay = true;
      video.muted = true;
      video.playsInline = true;
      video.preload = "auto";
      video.addEventListener("loadeddata", () => {
        video.play().catch(() => {});
      }, { once: true });
      stage.appendChild(video);
    } else {
      const image = document.createElement("img");
      image.src = item.src;
      image.alt = item.alt || previewAlt;
      stage.appendChild(image);
    }

    const hasMultipleItems = activeItems.length > 1;
    prevButton.hidden = !hasMultipleItems;
    nextButton.hidden = !hasMultipleItems;
    counter.hidden = !hasMultipleItems;
    counter.textContent = `${activeIndex + 1} / ${activeItems.length}`;
  };

  const openPopup = (items) => {
    if (!items.length) return;
    pauseGridVideos();
    activeItems = items;
    activeIndex = 0;
    renderActiveItem();
    popup.classList.add("is-open");
    popup.setAttribute("aria-hidden", "false");
    document.body.classList.add("media-popup-open");
  };

  const closePopup = () => {
    popup.classList.remove("is-open");
    popup.setAttribute("aria-hidden", "true");
    document.body.classList.remove("media-popup-open");
    stage.querySelectorAll("video").forEach((video) => video.pause());
    stage.innerHTML = "";
    activeItems = [];
    activeIndex = 0;
  };

  const showPrevious = () => {
    if (activeItems.length < 2) return;
    activeIndex = (activeIndex - 1 + activeItems.length) % activeItems.length;
    renderActiveItem();
  };

  const showNext = () => {
    if (activeItems.length < 2) return;
    activeIndex = (activeIndex + 1) % activeItems.length;
    renderActiveItem();
  };

  document.querySelectorAll(".reel-card").forEach((card) => {
    card.addEventListener("click", () => openPopup(getCardItems(card)));
    card.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        openPopup(getCardItems(card));
      }
    });
  });

  closeButton.addEventListener("click", closePopup);
  prevButton.addEventListener("click", showPrevious);
  nextButton.addEventListener("click", showNext);

  popup.addEventListener("click", (event) => {
    if (event.target === popup) closePopup();
  });

  document.addEventListener("keydown", (event) => {
    if (!popup.classList.contains("is-open")) return;
    if (event.key === "Escape") closePopup();
    if (event.key === "ArrowLeft") showPrevious();
    if (event.key === "ArrowRight") showNext();
  });
})();
</script>

</body>
</html>
